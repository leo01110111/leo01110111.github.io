{% assign e = include.entry %}
{% case e.kind %}
  {% when 'progress' %}{% assign icon = 'fa-solid fa-hammer' %}
  {% when 'take' %}{% assign icon = 'fa-solid fa-comment' %}
  {% when 'idea' %}{% assign icon = 'fa-solid fa-lightbulb' %}
  {% else %}{% assign icon = 'fa-solid fa-circle' %}
{% endcase %}
<article class="log-entry" id="{{ e.slug }}" data-kind="{{ e.kind | default: 'note' }}">
  <div class="log-meta">
    {% if e.kind %}<span class="log-kind log-kind-{{ e.kind }}"><i class="{{ icon }}"></i> {{ e.kind }}</span>{% endif %}
    <a class="log-date" href="{{ e.url | relative_url }}" title="permalink">{{ e.date | date: '%b %-d, %Y' }}</a>
  </div>
  {% if e.title and e.title != e.slug %}<h3 class="log-essay-title">{{ e.title }}</h3>{% endif %}
  <div class="log-body">{{ e.content | emojify }}</div>
  {% if e.tags.size > 0 %}
    <div class="log-tags">
      {% for tag in e.tags %}<span class="log-tag">#{{ tag }}</span>{% endfor %}
    </div>
  {% endif %}
</article>
